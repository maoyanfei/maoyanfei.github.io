// 滚动渐入动画 - 封装为全局函数，供 PJAX 调用
window.initGovScrollAnimation = function() {
  console.log('🔄 Initializing government style scroll animation...');
  
  // 获取所有需要动画的元素
  const animatedElements = document.querySelectorAll('.gov-section, .info-card, .duty-item, .achievement-item');
  
  if (animatedElements.length === 0) {
    console.log('⚠️ No animatable elements found');
    return;
  }
  
  console.log(`📊 Found ${animatedElements.length} elements to animate`);
  
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        // 每次进入视口都执行动画
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      } else {
        // 离开视口时重置状态，下次进入时重新动画
        entry.target.style.opacity = '0';
        entry.target.style.transform = 'translateY(20px)';
      }
    });
  }, observerOptions);
  
  // 为所有元素添加初始样式并开始观察
  animatedElements.forEach(el => {
    el.style.opacity = '0';
    el.style.transform = 'translateY(20px)';
    el.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    observer.observe(el);
  });
  
  console.log('✅ Government style animations initialized successfully');
};

// 首次加载时自动执行（浏览器会自然执行这段代码）
(function() {
  function init() {
    setTimeout(window.initGovScrollAnimation, 100);
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>]]></content><author><name>毛艳飞</name></author><category term="project" /><category term="电子政务" /><summary type="html"><![CDATA[]]></summary></entry><entry><title type="html">Testing MathJax</title><link href="http://192.168.1.3:4000/moment/2020/10/02/testing-mathjax/" rel="alternate" type="text/html" title="Testing MathJax" /><published>2020-10-02T15:32:00+08:00</published><updated>2020-10-02T15:32:00+08:00</updated><id>http://192.168.1.3:4000/moment/2020/10/02/testing-mathjax</id><content type="html" xml:base="http://192.168.1.3:4000/moment/2020/10/02/testing-mathjax/"><![CDATA[<p>Not Pure Poole supports <a href="https://www.mathjax.org/">MathJax</a>. You can enable it on a page by setting <code class="language-plaintext highlighter-rouge">math: true</code> in the front matter.</p>

