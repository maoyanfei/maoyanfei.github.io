<script>
// 打字机效果 - 封装为全局函数，供 PJAX 调用
window.initTypewriterEffect = function() {
  console.log('🔄 Initializing typewriter effect...');
  
  const text = "跨境汇款核心平台 | 赛博数据传输中...";
  const typingElement = document.getElementById('typing-text');
  
  // 如果元素不存在，直接返回
  if (!typingElement) {
    console.log('⚠️ typing-text element not found');
    console.log('💡 This might be a timing issue. Try increasing the delay.');
    return;
  }
  
  console.log('✅ Found typing-text element:', typingElement);
  
  let index = 0;
  let isDeleting = false;
  let loopTimeout;

  function typeWriter() {
    if (!isDeleting && index < text.length) {
      // 打字阶段
      typingElement.innerHTML = text.substring(0, index + 1);
      index++;
      loopTimeout = setTimeout(typeWriter, 100);
    } else if (!isDeleting && index === text.length) {
      // 打字完成，等待2秒后开始删除
      console.log('✅ Typewriter effect completed, waiting before delete...');
      loopTimeout = setTimeout(() => {
        isDeleting = true;
        typeWriter();
      }, 2000);
    } else if (isDeleting && index > 0) {
      // 删除阶段
      typingElement.innerHTML = text.substring(0, index - 1);
      index--;
      loopTimeout = setTimeout(typeWriter, 50); // 删除速度快一些
    } else if (isDeleting && index === 0) {
      // 删除完成，等待1秒后重新开始
      console.log('🔄 Typewriter effect deleted, restarting...');
      isDeleting = false;
      loopTimeout = setTimeout(typeWriter, 1000);
    }
  }

  // 清空之前的定时器（防止重复执行）
  if (typingElement._typewriterTimeout) {
    clearTimeout(typingElement._typewriterTimeout);
    console.log('🧹 Cleared previous timeout');
  }
  
  // 清空内容并开始
  typingElement.innerHTML = '';
  index = 0;
  isDeleting = false;
  
  // 延迟500ms后启动打字机效果
  loopTimeout = setTimeout(typeWriter, 500);
  
  // 保存定时器引用，方便清理
  typingElement._typewriterTimeout = loopTimeout;
  
  console.log('✅ Typewriter effect initialized with loop');
};

// 首次加载时自动执行（浏览器会自然执行这段代码）
(function() {
  console.log('📝 Typewriter script loaded');
  
  function init() {
    console.log('⏳ Calling initTypewriterEffect...');
    // 增加延迟时间，确保移动端 DOM 完全渲染
    setTimeout(window.initTypewriterEffect, 200);
  }
  
  if (document.readyState === 'loading') {
    console.log('⏳ Waiting for DOMContentLoaded...');
    document.addEventListener('DOMContentLoaded', init);
  } else {
    console.log('⚡ DOM already ready');
    init();
  }
})();
</script>]]></content><author><name>毛艳飞</name></author><category term="project" /><category term="网上银行" /><summary type="html"><![CDATA[]]></summary></entry><entry><title type="html">安哥拉国家税务稽查系统（SIGT）</title><link href="http://192.168.1.3:4000/project/2026/05/06/%E5%AE%89%E5%93%A5%E6%8B%89%E5%9B%BD%E5%AE%B6%E7%A8%8E%E5%8A%A1%E7%A8%BD%E6%9F%A5%E7%B3%BB%E7%BB%9F/" rel="alternate" type="text/html" title="安哥拉国家税务稽查系统（SIGT）" /><published>2026-05-06T15:11:00+08:00</published><updated>2026-05-06T15:11:00+08:00</updated><id>http://192.168.1.3:4000/project/2026/05/06/%E5%AE%89%E5%93%A5%E6%8B%89%E5%9B%BD%E5%AE%B6%E7%A8%8E%E5%8A%A1%E7%A8%BD%E6%9F%A5%E7%B3%BB%E7%BB%9F</id><content type="html" xml:base="http://192.168.1.3:4000/project/2026/05/06/%E5%AE%89%E5%93%A5%E6%8B%89%E5%9B%BD%E5%AE%B6%E7%A8%8E%E5%8A%A1%E7%A8%BD%E6%9F%A5%E7%B3%BB%E7%BB%9F/"><![CDATA[<style>
